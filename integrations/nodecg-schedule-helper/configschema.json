{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "url": {
      "type": "string",
      "default": "https://schedule.skenmy.com",
      "description": "Where Schedule Helper runs."
    },
    "room": {
      "type": "string",
      "default": "",
